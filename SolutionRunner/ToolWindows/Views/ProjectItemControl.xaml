<UserControl x:Class="SolutionRunner.ToolWindows.Views.ProjectItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:imagecatalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:theming="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:util="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Utilities"
             xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"         
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:local="clr-namespace:SolutionRunner.ToolWindows"
             xmlns:ViewModels="clr-namespace:SolutionRunner.ToolWindows.ViewModels"
             xmlns:Views="clr-namespace:SolutionRunner.ToolWindows.Views"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             toolkit:Themes.UseVsTheme="True"
             mc:Ignorable="d"
             d:DesignWidth="350"
             x:Name="ProjectItemControlDesign"
             Background="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SolutionRunner;component/ToolWindows/Styles/SharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="ReusableButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemInactiveBrushKey}}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                 BorderThickness="{TemplateBinding BorderThickness}" Padding="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarBorderBrushKey}}" />
                        <Setter Property="Background" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarMouseOverBackgroundGradientBrushKey}}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarMouseDownBackgroundGradientBrushKey}}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <d:UserControl.DataContext>
        <ViewModels:ProjectItemControlViewModel/>
    </d:UserControl.DataContext>

    <Grid MinHeight="26" local:MouseBehavior.Command="{Binding TryActivateProjectCommand}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Background" Value="{Binding Background, ElementName=ProjectItemControlDesign}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static platformUI:TreeViewColors.SelectedItemInactiveBrushKey}}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ProjectItem.IsStartingOrStopping}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProjectItem.IsStartingOrStopping}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Views:DotCircleSpinnerControl />
        </StackPanel>

        <imaging:CrispImage Grid.Column="0" Margin="5,0,0,0" Width="14" Height="14">
            <imaging:CrispImage.Style>
                <Style TargetType="imaging:CrispImage">
                    <Setter Property="Moniker" Value="{x:Static imagecatalog:KnownMonikers.RunOutlineNoColor}" />
                    <Setter Property="theming:ImageThemingUtilities.ImageBackgroundColor" Value="{Binding Background, ElementName=SolutionRunnerWindow, Converter={StaticResource BrushToColorConverter}}" />
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="ToolTip" Value="{x:Null}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ProjectItem.IsRunning}" Value="True">
                            <Setter Property="Moniker" Value="{x:Static imagecatalog:KnownMonikers.RunOutline}" />
                            <Setter Property="ToolTip" Value="Running" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProjectItem.IsDebugging}" Value="True">
                            <Setter Property="Moniker" Value="{x:Static imagecatalog:KnownMonikers.Run}" />
                            <Setter Property="ToolTip" Value="Debugging" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProjectItem.HaveBuildError}" Value="True">
                            <Setter Property="Moniker" Value="{x:Static imagecatalog:KnownMonikers.RunFailedTest}" />
                            <Setter Property="ToolTip" Value="Build Faild" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProjectItem.IsStartingOrStopping}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ProjectItem.IsStartingOrStopping}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </imaging:CrispImage.Style>
        </imaging:CrispImage>

        <StackPanel Grid.Column="1" HorizontalAlignment="Left" Margin="5,5,15,5">
            <TextBlock Text="{Binding ProjectItem.ProjectName}" 
               ToolTip="{Binding ProjectItem.SolutionProject.FullPath}"
               VerticalAlignment="Center" 
               TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProjectItem.IsChecked}" Value="False">
                                <Setter Property="FontWeight" Value="Normal" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ProjectItem.IsRunning}" Value="True">
                                <Setter Property="Foreground" Value="Green" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ProjectItem.HaveBuildError}" Value="True">
                                <Setter Property="Foreground" Value="Red" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ProjectItem.IsStartingOrStopping}" Value="True">
                                <Setter Property="Foreground" Value="Gray" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ProjectItem.NumberOfErrors}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <imaging:CrispImage Width="12" Height="12" Moniker="{x:Static imagecatalog:KnownMonikers.StatusError}"
                                theming:ImageThemingUtilities.ImageBackgroundColor="{Binding Background, ElementName=SolutionRunnerWindow, Converter={StaticResource BrushToColorConverter}}"/>
            <TextBlock Text="{Binding ProjectItem.NumberOfErrors}" FontSize="11" Margin="3,0,0,0" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ProjectItem.NumberOfWarnings}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <imaging:CrispImage Width="12" Height="12" Moniker="{x:Static imagecatalog:KnownMonikers.StatusWarning}"
                                theming:ImageThemingUtilities.ImageBackgroundColor="{Binding Background, ElementName=SolutionRunnerWindow, Converter={StaticResource BrushToColorConverter}}"/>
            <TextBlock Text="{Binding ProjectItem.NumberOfWarnings}" FontSize="11" Margin="3,0,0,0" />
        </StackPanel>

        <CheckBox Grid.Column="4" Margin="5,0" Width="58" IsThreeState="True" VerticalContentAlignment="Center"
                  IsChecked="{Binding ProjectItem.IsChecked}">
            <CheckBox.Content>
                <TextBlock Text="{Binding ProjectItem.ProjectRunType}" />
            </CheckBox.Content>
        </CheckBox>

        <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Hidden" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=
                               Grid, AncestorLevel=1}}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Button x:Name="StartProjectButton" Command="{Binding StartProjectCommand}" ToolTip="Start Project">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ReusableButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProjectItem.IsRunning}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                
                <imaging:CrispImage Width="14" Height="14" Moniker="{x:Static imagecatalog:KnownMonikers.Run}"
                                    theming:ImageThemingUtilities.ImageBackgroundColor="{Binding Background, ElementName=StartProjectButton, Converter={StaticResource BrushToColorConverter}}"/>
            </Button>

            <Button x:Name="RestartProjectButton" Command="{Binding RestartProjectCommand}" ToolTip="Restart Project">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ReusableButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProjectItem.IsRunning}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>

                <imaging:CrispImage Width="14" Height="14" Moniker="{x:Static imagecatalog:KnownMonikers.Restart}"
                                    theming:ImageThemingUtilities.ImageBackgroundColor="{Binding Background, ElementName=RestartProjectButton, Converter={StaticResource BrushToColorConverter}}"/>
            </Button>

            <Button x:Name="AttachProjectButton" Command="{Binding AttachProjectCommand}" ToolTip="Attach Project">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ReusableButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProjectItem.IsDebugging}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>

                <imaging:CrispImage Width="14" Height="14" Moniker="{x:Static imagecatalog:KnownMonikers.Online}"
                                   theming:ImageThemingUtilities.ImageBackgroundColor="{Binding Background, ElementName=AttachProjectButton, Converter={StaticResource BrushToColorConverter}}"/>
            </Button>

            <Button x:Name="DetachProjectButton" Command="{Binding DetachProjectCommand}" ToolTip="Detach Project">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ReusableButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProjectItem.IsDebugging}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>

                <imaging:CrispImage Width="14" Height="14" Moniker="{x:Static imagecatalog:KnownMonikers.Disconnect}"
                                   theming:ImageThemingUtilities.ImageBackgroundColor="{Binding Background, ElementName=DetachProjectButton, Converter={StaticResource BrushToColorConverter}}"/>
            </Button>

            <Button x:Name="StopProjectButton" Command="{Binding StopProjectCommand}" Style="{StaticResource ReusableButtonStyle}" ToolTip="Stop Project">
                <imaging:CrispImage Width="14" Height="14" Moniker="{x:Static imagecatalog:KnownMonikers.Stop}"
                                    theming:ImageThemingUtilities.ImageBackgroundColor="{Binding Background, ElementName=StopProjectButton, Converter={StaticResource BrushToColorConverter}}"/>
            </Button>

            <Button x:Name="ShowProcessButton" Command="{Binding ShowProcessCommand}" Style="{StaticResource ReusableButtonStyle}" ToolTip="Show Process">
                <imaging:CrispImage Width="14" Height="14" Moniker="{x:Static imagecatalog:KnownMonikers.JSHubApplication}"
                                theming:ImageThemingUtilities.ImageBackgroundColor="{Binding Background, ElementName=ShowProcessButton, Converter={StaticResource BrushToColorConverter}}"/>
            </Button>
        </StackPanel>

    </Grid>
</UserControl>
