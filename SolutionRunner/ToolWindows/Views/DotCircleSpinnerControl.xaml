                            <LinearDoubleKeyFrame KeyTime="00:00:01.10" Value="0.25" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Inactive" />
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid>
            <Canvas Width="14" Height="14" Margin="3">
                <Ellipse x:Name="ellipse01" Canvas.Top="6" Width="2.5" Height="2.5" Opacity="0" Fill="{DynamicResource IndicatorForeground}" />
                <Ellipse x:Name="ellipse02" Canvas.Left="0.9" Canvas.Top="3" Width="2.5" Height="2.5" Opacity="0" Fill="{DynamicResource IndicatorForeground}" />
                <Ellipse x:Name="ellipse03" Canvas.Left="3" Canvas.Top="0.9" Width="2.5" Height="2.5" Opacity="0" Fill="{DynamicResource IndicatorForeground}" />
                <Ellipse x:Name="ellipse04" Canvas.Left="6" Canvas.Top="0" Width="2.5" Height="2.5" Opacity="0" Fill="{DynamicResource IndicatorForeground}" />
                <Ellipse x:Name="ellipse05" Canvas.Left="9" Canvas.Top="0.9" Width="2.5" Height="2.5" Opacity="0" Fill="{DynamicResource IndicatorForeground}" />
                <Ellipse x:Name="ellipse06" Canvas.Left="11" Canvas.Top="3" Width="2.5" Height="2.5" Opacity="0" Fill="{DynamicResource IndicatorForeground}" />
                <Ellipse x:Name="ellipse07" Canvas.Left="12" Canvas.Top="6" Width="2.5" Height="2.5" Opacity="0" Fill="{DynamicResource IndicatorForeground}" />
                <Ellipse x:Name="ellipse08" Canvas.Left="11" Canvas.Top="9" Width="2.5" Height="2.5" Opacity="0" Fill="{DynamicResource IndicatorForeground}" />
                <Ellipse x:Name="ellipse09" Canvas.Left="9" Canvas.Top="11" Width="2.5" Height="2.5" Opacity="0" Fill="{DynamicResource IndicatorForeground}" />
                <Ellipse x:Name="ellipse10" Canvas.Left="6" Canvas.Top="12" Width="2.5" Height="2.5" Opacity="0" Fill="{DynamicResource IndicatorForeground}" />
                <Ellipse x:Name="ellipse11" Canvas.Left="3" Canvas.Top="11" Width="2.5" Height="2.5" Opacity="0" Fill="{DynamicResource IndicatorForeground}" />
                <Ellipse x:Name="ellipse12" Canvas.Left="0.9" Canvas.Top="9" Width="2.5" Height="2.5" Opacity="0" Fill="{DynamicResource IndicatorForeground}" />
            </Canvas>
        </Grid>
    </Grid>
</UserControl>