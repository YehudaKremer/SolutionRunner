<UserControl x:Class="SolutionRunner.ToolWindows.Views.SolutionRunnerWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:theming="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:util="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Utilities"
             xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"         
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:ViewModels="clr-namespace:SolutionRunner.ToolWindows.ViewModels"
             xmlns:Views="clr-namespace:SolutionRunner.ToolWindows.Views"
             toolkit:Themes.UseVsTheme="True"
             mc:Ignorable="d"
             d:DesignHeight="300" 
             d:DesignWidth="350"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Name="SolutionRunnerWindow">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <d:ResourceDictionary Source="pack://application:,,,/SolutionRunner;component/ToolWindows/Themes/LightThemeResources.xaml" />
                <ResourceDictionary Source="pack://application:,,,/SolutionRunner;component/ToolWindows/Themes/SharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataContext>
        <ViewModels:SolutionRunnerWindowControlViewModel/>
    </UserControl.DataContext>

    <!--TODO delete RootGrid name-->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarGradientBrushKey}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="4,2" UseLayoutRounding="True">
                <Button Name="StartButton" Command="{Binding StartAllSelectedProjectsCommand}" ToolTip="Start All Selected Projects" Style="{StaticResource ReusableButtonStyle}">
                    <Image x:Name="StartButtonIcon" Width="16" Height="16" Source="{DynamicResource RunAllImage}" />
                </Button>

                <Button Name="StopAllProjectsButton" Command="{Binding StopAllProjectsCommand}" ToolTip="Stop All Running Projects (0)" Style="{StaticResource ReusableButtonStyle}">
                    <Image Width="16" Height="16" Source="{DynamicResource StopImage}" />
                </Button>

                <Rectangle Width="1" Margin="4,1" Fill="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarToolBarSeparatorBrushKey}}" />

                <Button Command="{Binding ShowAllProcessesButton_ClickCommand}" ToolTip="Show All Running Processes" Style="{StaticResource ReusableButtonStyle}">
                    <Image Width="16" Height="16" Source="{DynamicResource JSHubApplicationImage}"/>
                </Button>

                <Button Command="{Binding MinimizeAllProcessesButton_ClickCommand}" ToolTip="Minimize All Running Processes" Style="{StaticResource ReusableButtonStyle}">
                    <Image Width="16" Height="16" Source="{DynamicResource JSFixedLayoutApplicationImage}" />
                </Button>
            </StackPanel>

            <!--<StackPanel Orientation="Horizontal" Grid.Column="1">
                <Image Width="14" Height="14" Source="{DynamicResource RunOutlineImage}" />
            </StackPanel>-->
        </Grid>

        <!--<Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" />-->
        <Separator Grid.Row="1" Margin="0" Background="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarToolBarSeparatorBrushKey}}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Views:ProjectItemControl />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel x:Name="ProjectsPanel" Visibility="Collapsed">
            <!--CheckBoxes will be added here dynamically-->
        </StackPanel>

    </Grid>
</UserControl>
