<UserControl x:Class="SolutionRunner.ToolWindows.Views.SolutionRunnerWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:imagecatalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:theming="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"             
             xmlns:util="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Utilities"
             xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"         
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:ViewModels="clr-namespace:SolutionRunner.ToolWindows.ViewModels"
             xmlns:Views="clr-namespace:SolutionRunner.ToolWindows.Views"
             toolkit:Themes.UseVsTheme="True"
             mc:Ignorable="d"
             d:DesignHeight="300" 
             d:DesignWidth="350"
             Background="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}"
             Name="SolutionRunnerWindow">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SolutionRunner;component/ToolWindows/Styles/SharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="ReusableButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarGradientBrushKey}}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                 BorderThickness="{TemplateBinding BorderThickness}" Padding="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarBorderBrushKey}}" />
                        <Setter Property="Background" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarMouseOverBackgroundGradientBrushKey}}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarMouseDownBackgroundGradientBrushKey}}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.DataContext>
        <ViewModels:SolutionRunnerWindowControlViewModel/>
    </UserControl.DataContext>

    <!--TODO delete RootGrid name-->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarGradientBrushKey}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="4,2">
                <Button x:Name="StartButton" Command="{Binding StartAllSelectedProjectsCommand}" ToolTip="Start All Selected Projects" Style="{StaticResource ReusableButtonStyle}">
                    <imaging:CrispImage Moniker="{x:Static imagecatalog:KnownMonikers.RunAll}" 
                                         theming:ImageThemingUtilities.ImageBackgroundColor="{Binding Background, ElementName=StartButton, Converter={StaticResource BrushToColorConverter}}"/>
                </Button>

                <Button x:Name="StopAllProjectsButton" Command="{Binding StopAllProjectsCommand}" ToolTip="Stop All Running Projects (0)" Style="{StaticResource ReusableButtonStyle}">
                    <imaging:CrispImage Moniker="{x:Static imagecatalog:KnownMonikers.Stop}"
                                        theming:ImageThemingUtilities.ImageBackgroundColor="{Binding Background, ElementName=StopAllProjectsButton, Converter={StaticResource BrushToColorConverter}}"/>
                </Button>

                <Rectangle Width="1" Margin="4,1" Fill="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarToolBarSeparatorBrushKey}}" />

                <Button x:Name="ShowAllProcessesButton" Command="{Binding ShowAllProcessesButton_ClickCommand}" ToolTip="Show All Running Processes" Style="{StaticResource ReusableButtonStyle}">
                    <imaging:CrispImage Moniker="{x:Static imagecatalog:KnownMonikers.JSHubApplication}"
                                        theming:ImageThemingUtilities.ImageBackgroundColor="{Binding Background, ElementName=ShowAllProcessesButton, Converter={StaticResource BrushToColorConverter}}"/>
                </Button>

                <Button x:Name="MinimizeAllProcessesButton" Command="{Binding MinimizeAllProcessesButton_ClickCommand}" ToolTip="Minimize All Running Processes" Style="{StaticResource ReusableButtonStyle}">
                    <imaging:CrispImage Moniker="{x:Static imagecatalog:KnownMonikers.JSFixedLayoutApplication}"
                                        theming:ImageThemingUtilities.ImageBackgroundColor="{Binding Background, ElementName=MinimizeAllProcessesButton, Converter={StaticResource BrushToColorConverter}}"/>
                </Button>
                <!--<d:Button Style="{StaticResource ReusableButtonStyle}">
                    <d:Image Width="14" Height="14" Source="/SolutionRunner;component/Assets/DesignTimeImages/JSFixedLayoutApplication.png" />
                </d:Button>-->
            </StackPanel>

            <!--<StackPanel Orientation="Horizontal" Grid.Column="1">
                <Image Width="14" Height="14" Source="{DynamicResource RunOutlineImage}" />
            </StackPanel>-->
        </Grid>

        <!--<Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" />-->
        <Separator Grid.Row="1" Margin="0" Background="{DynamicResource {x:Static platformUI:EnvironmentColors.CommandBarToolBarSeparatorBrushKey}}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Views:ProjectItemControl />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel x:Name="ProjectsPanel" Visibility="Collapsed">
            <!--CheckBoxes will be added here dynamically-->
        </StackPanel>

    </Grid>
</UserControl>
